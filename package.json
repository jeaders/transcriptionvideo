{
  "name": "nextjs-postgresql-template",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:start": "node_modules/@embedded-postgres/linux-x64/native/bin/pg_ctl -D .pgdata -l .pgdata/postgres.log start",
    "db:stop": "node_modules/@embedded-postgres/linux-x64/native/bin/pg_ctl -D .pgdata stop",
    "db:init": "node scripts/db-init.mjs",
    "migrate": "node scripts/migrate.mjs",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "next": "^16.4.4",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "@embedded-postgres/linux-x64": "^18.6.0-beta.19",
    "embedded-postgres": "^18.6.0-beta.19"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.16.6",
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.4.4",
    "postcss": "8.5.32",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  }
}
