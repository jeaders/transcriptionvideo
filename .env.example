# Connessione PostgreSQL (istanza embedded in user-space: npm run db:init && npm run db:start)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# yt-dlp da usare al posto di quello di sistema (consigliato se la versione di sistema è vecchia)
# YTDLP_PATH=/home/NOMEUTENTE/.local/bin/yt-dlp

# Whisper AI server-side: basta UNA delle due (Groq offre un piano gratuito: https://console.groq.com/keys)
# GROQ_API_KEY=
# OPENAI_API_KEY=
# Eventuale base URL personalizzata per OpenAI
# OPENAI_BASE_URL=
# Modelli personalizzati
# STT_MODEL=
# CHAT_MODEL=

# Email registrata su MyMemory per innalzare la quota gratuita di traduzione
# MYMEMORY_EMAIL=you@example.com
