{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trascrivo",
  "version": "1.0.0",
  "identifier": "com.trascrivo.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../.next"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Trascrivo",
        "width": 1280,
        "height": 820,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [],
    "resources": ["../.next", "../node_modules", "../package.json", "../drizzle", "../scripts"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}